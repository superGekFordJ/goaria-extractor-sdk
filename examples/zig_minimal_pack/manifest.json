{
  "pack_id": "zig-minimal-pack",
  "pack_version": "0.1.0",
  "abi_version": 1,
  "name": "Zig Minimal Pack",
  "description": "Reference Zig URL extractor pack for GoAria SDK testing",
  "authors": ["GoAria Team"],
  "domains": [
    {
      "host": "share.fixture.invalid",
      "include_subdomains": false
    },
    {
      "host": "fixture.invalid",
      "include_subdomains": true
    }
  ],
  "capabilities": [
    "cap.parse.wasm",
    "cap.http.fetch"
  ],
  "resource_limits": {
    "timeout_millis": 5000,
    "max_memory_pages": 32,
    "max_host_calls": 10,
    "max_response_bytes": 1048576,
    "max_output_items": 100,
    "max_output_bytes": 1048576
  }
}
