{
  "pack_id": "xpk-imgur01",
  "pack_version": "2026.1.1",
  "abi_version": 1,
  "description": "GoAria extractor pack for Imgur (imgur.com)",
  "domains": [
    {
      "host": "imgur.com",
      "include_subdomains": true
    }
  ],
  "capabilities": [
    "cap.parse.wasm",
    "cap.http.fetch"
  ],
  "resource_limits": {
    "timeout_millis": 5000,
    "max_memory_pages": 32,
    "max_host_calls": 10,
    "max_response_bytes": 1048576,
    "max_output_items": 50,
    "max_output_bytes": 1048576
  }
}
